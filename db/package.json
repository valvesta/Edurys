{
  "name": "durys-db",
  "version": "0.1.0",
  "private": true,
  "description": "Duomenų bazės migracijos, katalogo importas ir testai",
  "scripts": {
    "extract:erkado": "node tools/extract-erkado.js",
    "verify:bundle": "node tools/verify-catalog.js",
    "migrate": "node tools/migrate.js",
    "migrate:dry": "node tools/migrate.js --dry-run",
    "import:erkado": "node tools/import-catalog.js catalog/erkado-2026-I.bundle.json",
    "import:erkado:publish": "node tools/import-catalog.js catalog/erkado-2026-I.bundle.json --publish",
    "test": "node --test tests/*.test.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "mssql": "^11.0.1"
  }
}
